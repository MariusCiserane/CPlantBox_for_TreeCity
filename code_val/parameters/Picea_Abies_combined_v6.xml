<parameter name="lnk" value="0"/>
<parameter name="theta" value="0.06" dev="0.02"/>
<parameter name="dx" value="1.5"/>
<parameter name="dxMin" value="1e-06"/>
<parameter name="ldelay" value="-1"/>
<parameter name="gf" value="1"/>
<parameter name="tropismT" value="0"/>
<parameter name="tropismN" value="6"/>
<parameter name="tropismS" value="0.012"/>
<parameter name="successor" ruleId="0" numLat="1" Where="" subType="2" organType="2" percentage="1.0"/>
</root>
<!--   Dominant, long, shallow plate-forming roots.   -->
<root name="structural_plate_laterals" subType="2">
<parameter name="a" value="0.15" dev="0.02"/>
<!--   Slow structural elongation prevents the 500 cm limit being reached before age 15.   -->
<parameter name="r" value="0.030" dev="0.0065"/>
<parameter name="lmax" value="500" dev="190"/>
<parameter name="rlt" value="1e+09"/>
<parameter name="la" value="10"/>
<parameter name="lb" value="4"/>
<!--   Moderate spacing: maintains mature coverage without recursive thickets.   -->
<parameter name="ln" value="20" dev="2"/>
<parameter name="lnk" value="0.005"/>
<!--   Nearly horizontal, with enough variation for a natural shallow plate.   -->
<parameter name="theta" value="1.48" dev="0.05"/>
<parameter name="dx" value="3.0"/>
<parameter name="dxMin" value="1e-06"/>
<parameter name="ldelay" value="-1"/>
<parameter name="gf" value="1"/>
<parameter name="tropismT" value="0"/>
<!--   More trials + lower angular noise straighten the woody plate; the
         Python PiceaStructuralTropism reads these same values.   -->
<parameter name="tropismN" value="8"/>
<parameter name="tropismS" value="0.006"/>
<!--  
    Conservative hierarchy: terminal fine roots are moderate, exploratory
    branches are uncommon, sinkers are rare, and subtype 2 never creates
    another subtype 2. This prevents recursive structural thickets.
      -->
<parameter name="successor" ruleId="0" numLat="1" Where="" subType="3" organType="2" percentage="0.64"/>
<parameter name="successor" ruleId="1" numLat="1" Where="" subType="6" organType="2" percentage="0.12"/>
<parameter name="successor" ruleId="2" numLat="1" Where="" subType="4" organType="2" percentage="0.06"/>
</root>
<!--  
  Fine transport roots. CPlantBox does not regenerate fine roots repeatedly
  along old axes, so these roots are retained as a cumulative contact envelope
  for damaged/leaking-pipe assessment during the 60-year simulation.
    -->
<root name="fine_transport_roots" subType="3">
<parameter name="a" value="0.025" dev="0.004"/>
<parameter name="r" value="0.07"/>
<parameter name="lmax" value="14" dev="3"/>
<!--   Persistent contact envelope: CPlantBox does not regenerate dead fine roots.   -->
<parameter name="rlt" value="1e+09"/>
<parameter name="la" value="1.5"/>
<parameter name="lb" value="0.5"/>
<parameter name="ln" value="5.0" dev="1.0"/>
<parameter name="lnk" value="0"/>
<parameter name="theta" value="1.35" dev="0.30"/>
<parameter name="dx" value="0.6"/>
<parameter name="dxMin" value="1e-06"/>
<parameter name="ldelay" value="-1"/>
<parameter name="gf" value="1"/>
<parameter name="tropismT" value="0"/>
<!--   Still flexible, but low enough that fine roots no longer curl into loops.   -->
<parameter name="tropismN" value="3"/>
<parameter name="tropismS" value="0.08"/>
<!--   Fine transport roots create the missing absorbing-root hierarchy.   -->
<parameter name="successor" ruleId="0" numLat="1" Where="" subType="5" organType="2" percentage="0.18"/>
</root>
<!--   Rare structural sinkers for pipes beneath the shallow root plate.   -->
<root name="structural_sinkers" subType="4">
<parameter name="a" value="0.08" dev="0.012"/>
<parameter name="r" value="0.11"/>
<parameter name="lmax" value="95" dev="25"/>
<parameter name="rlt" value="1e+09"/>
<parameter name="la" value="4"/>
<parameter name="lb" value="1"/>
<parameter name="ln" value="18" dev="4"/>
<parameter name="lnk" value="0"/>
<parameter name="theta" value="0.05" dev="0.02"/>
<parameter name="dx" value="2.0"/>
<parameter name="dxMin" value="1e-06"/>
<parameter name="ldelay" value="-1"/>
<parameter name="gf" value="1"/>
<parameter name="tropismT" value="0"/>
<!--  Wider candidate search for obstacle avoidance. The engine's strong
       sinker-depth objective still selects near-vertical growth away from pipes,
       while the wider search provides legal tangential candidates near a hard pipe.  -->
<parameter name="tropismN" value="32"/>
<parameter name="tropismS" value="0.080"/>
<!--   Fine roots may develop from the few retained structural sinkers.   -->
<parameter name="successor" ruleId="0" numLat="1" Where="" subType="3" organType="2" percentage="0.20"/>
<!--  AI3RSS: ST4->ST7 apex birth re-enabled at 0.15. Razan's generator disabled it
       (percentage 0.0) because its Python tropism could not reject the first segment of
       an apex lateral near a solid pipe. The AI3RSS pipeline uses the native C++ tropism
       with SDF confinement instead, so the guard is not needed here. Measured effect at
       60 and 120 years: maximum depth 137 -> 254 cm, 95th percentile 84 -> 166 cm. At 0.30
       the depth no longer increases, only the number of sinkers.  -->
<parameter name="successor" ruleId="1" numLat="1" Where="apex" subType="7" organType="2" percentage="0.15"/>
</root>
